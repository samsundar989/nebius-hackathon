# secrets
.env
.env.*
!.env.example
*.pem
*.key

# python
__pycache__/
*.py[cod]
.venv/
.venv-win/
.uv-cache/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# run artifacts (keep the README)
runs/*
!runs/README.md

# datasets and large downloads (fetched by scripts)
data/
!site/data/
cases/**/src/
cases/**/*.zip
cases/**/*.tar*

# build outputs
cmake-build-*/
out/
*.o
*.so
*.a
*.exe

# editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# strategy material (local only; never commit)
docs/research/
docs/kickoff/

# Evidence bundles are regenerated by scripts/render_bundle.py; two are kept as README showcases.
docs/bundles/*
!docs/bundles/42520955.md
!docs/bundles/42530604.md

# Open-bug cases: upstream clones stay local (cases/open_bugs/<id>/src).
cases/open_bugs/*/src/

# Video draft: rendered clips and the assembled draft stay local (video/record.py rebuilds them).
video/clips/
video/*.mp4

# local copies with real identities (review #8 order 5)
*.private.*

# narration recordings (yours or the TTS fallback)
video/*.wav
video/*.m4a
