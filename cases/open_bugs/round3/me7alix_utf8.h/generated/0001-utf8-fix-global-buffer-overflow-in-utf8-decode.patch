From: <your git identity>
Date: Mon, 26 Oct 2026 19:15:06 +0000
Subject: [PATCH] utf8: fix global-buffer-overflow in utf8_decode()

AddressSanitizer reports a global-buffer-overflow in utf8_decode()
(utf8.h:37).
This changes utf8.h (+12/-0).

Part of #1.
---
 utf8.h | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/utf8.h b/utf8.h
--- a/utf8.h
+++ b/utf8.h
@@ -19,12 +19,20 @@
 
 	if ((p[0] & 0xE0) == 0xC0) {
 		*bytes_read = 2;
+		if (p[1] == 0) {
+			*bytes_read = 1;
+			return 0xFFFD;
+		}
 		return ((p[0] & 0x1F) << 6) |
 		       (p[1] & 0x3F);
 	}
 
 	if ((p[0] & 0xF0) == 0xE0) {
 		*bytes_read = 3;
+		if (p[1] == 0 || p[2] == 0) {
+			*bytes_read = 1;
+			return 0xFFFD;
+		}
 		return ((p[0] & 0x0F) << 12) |
 		       ((p[1] & 0x3F) << 6) |
 		       (p[2] & 0x3F);
@@ -32,6 +40,10 @@
 
 	if ((p[0] & 0xF8) == 0xF0) {
 		*bytes_read = 4;
+		if (p[1] == 0 || p[2] == 0 || p[3] == 0) {
+			*bytes_read = 1;
+			return 0xFFFD;
+		}
 		return ((p[0] & 0x07) << 18) |
 		       ((p[1] & 0x3F) << 12) |
 		       ((p[2] & 0x3F) << 6) |
--
leakproof package
